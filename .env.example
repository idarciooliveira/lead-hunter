# Lead Hunter configuration.
# Copy this file to .env in the project root and replace the values.
# The app reads .env on startup. Never commit .env; it is in .gitignore.
# Real environment variables win over this file, so Railway settings take precedence.

# --- Required for `campaign run` ---------------------------------------------
# Apify API token: console.apify.com > Settings > API & Integrations.
APIFY_TOKEN=apify_api_replace_me

# --- LLM through the Vercel AI Gateway (ADR 0017) ---------------------------
# Key: Vercel dashboard > AI Gateway > API Keys. Check it with `lead-hunter llm test`.
AI_GATEWAY_API_KEY=replace_me
# Any gateway model id in provider/model form. Gemma 4 26B A4B is for testing.
LEADHUNTER_LLM_MODEL=google/gemma-4-26b-a4b-it

# --- API service token (ADR 0037) --------------------------------------------
# The web server sends it as a bearer token and the API refuses every call without it.
# The API will not start in the web profile when it is empty. Make one with: openssl rand -hex 32
# ./dev makes a temporary one when this is unset; docker compose up needs it here.
# LEADHUNTER_API_TOKEN=

# --- Database -----------------------------------------------------------------
# These defaults match docker-compose.yml. On Railway, the Postgres service
# provides PGHOST, PGPORT, PGDATABASE, PGUSER and PGPASSWORD for you.
PGHOST=localhost
PGPORT=5432
PGDATABASE=leadhunter
PGUSER=leadhunter
PGPASSWORD=leadhunter

# --- Budget (optional) --------------------------------------------------------
# Refuse a campaign run that could return more places than this.
LEADHUNTER_APIFY_MAX_PLACES_PER_RUN=600
# Price per place used by --dry-run estimates. Copy it from the actor's pricing page.
LEADHUNTER_APIFY_ESTIMATED_USD_PER_PLACE=0.004
# The budget that `usage` draws its bar against, in USD per month.
LEADHUNTER_USAGE_MONTHLY_BUDGET_USD=10
# Qualified leads enriched per `campaign enrich` run.
LEADHUNTER_STAGE2_BATCH=25
# Recent reviews fetched per place for the complaint classification.
LEADHUNTER_STAGE2_MAX_REVIEWS=10
