#!/usr/bin/env sh
# The definition of done: environment checks, then build and every test, with the integration tests required.
# Usage: ./check [backend|web]   (no argument runs both; see ADR 0034 and 0035)
set -e
cd "$(dirname "$0")"
fail() { echo "check: $*" >&2; exit 1; }

scope="${1:-all}"
case "$scope" in
  all|backend|web) ;;
  *) fail "unknown scope '$scope'. Usage: ./check [backend|web]" ;;
esac

check_backend() {
  # Non-interactive shells (agents, IDEs) do not load SDKMAN, so pick up the JDK pinned in .sdkmanrc.
  sdk_java="$HOME/.sdkman/candidates/java/$(sed -n 's/^java=//p' .sdkmanrc 2>/dev/null)"
  if [ -z "$JAVA_HOME" ] && [ -x "$sdk_java/bin/javac" ]; then
    JAVA_HOME="$sdk_java"
    export JAVA_HOME
  fi
  # Align PATH with JAVA_HOME so the javac validated below is the one Maven will use.
  if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/javac" ]; then
    PATH="$JAVA_HOME/bin:$PATH"
  fi
  command -v javac >/dev/null 2>&1 || fail "javac not found. Install JDK 21 with SDKMAN (sdk env). See CLAUDE.md."
  version=$(javac -version 2>&1 | sed -n 's/^javac \([0-9]*\).*/\1/p')
  [ "$version" = "21" ] || fail "JDK 21 required, found $version. Run: sdk env"

  for script in lh check dev backend/mvnw; do
    if grep -q "$(printf '\r')" "$script"; then
      fail "$script has CRLF line endings. Run: git add --renormalize . and re-checkout the file."
    fi
  done

  if [ -z "$LEADHUNTER_TEST_JDBC_URL" ] && ! docker info >/dev/null 2>&1; then
    fail "no database for the integration tests. Start Docker or set LEADHUNTER_TEST_JDBC_URL to an empty Postgres database."
  fi

  # A skipped integration test can hide a broken query, so a missing database fails instead.
  LEADHUNTER_REQUIRE_DB=true ./backend/mvnw -B -f backend/pom.xml verify
}

check_web() {
  command -v node >/dev/null 2>&1 || fail "node not found. Install Node 22 or newer. See web/README.md."
  command -v pnpm >/dev/null 2>&1 || fail "pnpm not found. Run: corepack enable"
  (
    cd web
    pnpm install --frozen-lockfile
    pnpm lint
    pnpm typecheck
    pnpm test
    # Builds the app, then runs the smoke tests against the production server.
    pnpm test:e2e
  )
}

if [ "$scope" = all ] || [ "$scope" = backend ]; then check_backend; fi
if [ "$scope" = all ] || [ "$scope" = web ]; then check_web; fi
echo "check: ok"
