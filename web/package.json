{
	"name": "web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"generate-routes": "tsr generate",
		"typecheck": "tsr generate && tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write",
		"test": "vitest run",
		"test:e2e": "playwright test --project=smoke && playwright test -c playwright.integration.config.ts",
		"screenshots": "playwright test --project=screenshots"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-query": "5.104.1",
		"@tanstack/react-query-devtools": "5.104.1",
		"@tanstack/react-router": "1.170.41",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.168.60",
		"@tanstack/react-table": "^9.2.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"lucide-react": "^0.577.0",
		"nitro": "3.0.260610-beta",
		"radix-ui": "^1.6.7",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@playwright/test": "^1.63.0",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/router-cli": "^1.132.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"jsdom": "^30.1.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=22"
	}
}
